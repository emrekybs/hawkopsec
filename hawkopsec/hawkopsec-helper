fs.protected_symlinks=1
fs.protected_fifos=2
fs.protected_regular=2
fs.suid_dumpable=0
"""


def harden_sysctl():
    write_file(SYSCTL_FILE, SYSCTL_BODY); run(["sysctl", "--system"])
    flag("sysctl", True); log("kernel hardening applied."); return 0


def unharden_sysctl():
    if os.path.exists(SYSCTL_FILE): os.remove(SYSCTL_FILE)
    flag("sysctl", False); log("kernel hardening removed (values reset on reboot)."); return 0


def firewall_on():
    if not have("nft"): log("nftables missing"); return 1
    rules = """
table inet hawkopsec_fw {
  chain input {
    type filter hook input priority 0; policy drop;
    iif lo accept
    ct state established,related accept
    ct state invalid drop
    ip protocol icmp icmp type echo-request limit rate 5/second accept
    ip6 nexthdr icmpv6 accept
  }
  chain forward { type filter hook forward priority 0; policy drop; }
  chain output  { type filter hook output  priority 0; policy accept; }
}
"""
    rc, o = run(["nft", "-f", "-"], input_text=rules)
    if rc != 0: log("nft error: " + o); return 1
    flag("firewall", True); log("firewall active — default-deny inbound."); return 0


def firewall_off():
    run(["nft", "delete", "table", "inet", "hawkopsec_fw"])
    flag("firewall", False); log("firewall disabled."); return 0


IPV6_FILE = "/etc/sysctl.d/98-hawkopsec-ipv6.conf"


def ipv6_off():
    write_file(IPV6_FILE, "net.ipv6.conf.all.disable_ipv6=1\n"
               "net.ipv6.conf.default.disable_ipv6=1\nnet.ipv6.conf.lo.disable_ipv6=1\n")
    run(["sysctl", "--system"]); flag("ipv6_off", True); log("IPv6 disabled."); return 0


def ipv6_on():
    if os.path.exists(IPV6_FILE): os.remove(IPV6_FILE)
    for s in ("all", "default", "lo"):
        run(["sysctl", "-w", f"net.ipv6.conf.{s}.disable_ipv6=0"])
    flag("ipv6_off", False); log("IPv6 re-enabled."); return 0


# --------------------------------------------------------------------------- #
#  Crash reporting / coredumps  (distro-aware)
# --------------------------------------------------------------------------- #
COREDUMP_DROPIN = "/etc/systemd/coredump.conf.d/hawkopsec.conf"


def telemetry_off():
    st = load_state(); prev = st.setdefault("tele_prev", {})
    for svc in TELE_SVCS:
        rc, en = run(["systemctl", "is-enabled", svc])
        if "not-found" not in en:
            prev[svc] = en.strip()
            run(["systemctl", "disable", "--now", svc])
    save_state(st)
    backup_file(COREDUMP_DROPIN)
    write_file(COREDUMP_DROPIN, "[Coredump]\nStorage=none\nProcessSizeMax=0\n")
    run(["systemctl", "daemon-reload"])
    if os.path.exists("/etc/default/apport"):
        backup_file("/etc/default/apport"); write_file("/etc/default/apport", "enabled=0\n")
    flag("telemetry", True); log("crash reporting / coredumps disabled."); return 0


def telemetry_restore():
    st = load_state()
    for svc, en in st.get("tele_prev", {}).items():
        if en in ("enabled", "enabled-runtime", "static"):
            run(["systemctl", "enable", "--now", svc])
    restore_file(COREDUMP_DROPIN); restore_file("/etc/default/apport")
    run(["systemctl", "daemon-reload"])
    st.pop("tele_prev", None); st.pop("telemetry", None); save_state(st)
    log("crash reporting restored."); return 0


# --------------------------------------------------------------------------- #
#  Bluetooth / swap / USB lock  (new OPSEC modules)
# --------------------------------------------------------------------------- #
def bluetooth_off():
    st = load_state()
    rc, act = run(["systemctl", "is-active", "bluetooth.service"])
    st["bt_was_active"] = (act.strip() == "active"); save_state(st)
    run(["rfkill", "block", "bluetooth"])
    run(["systemctl", "stop", "bluetooth.service"])
    flag("bluetooth_off", True); log("Bluetooth blocked."); return 0


def bluetooth_on():
    run(["rfkill", "unblock", "bluetooth"])
    st = load_state()
    if st.get("bt_was_active"): run(["systemctl", "start", "bluetooth.service"])
    st.pop("bt_was_active", None); st.pop("bluetooth_off", None); save_state(st)
    log("Bluetooth unblocked."); return 0


def swap_off():
    run(["swapoff", "-a"]); flag("swap_off", True)
    log("swap disabled (prevents secrets leaking to disk)."); return 0


def swap_on():
    run(["swapon", "-a"]); flag("swap_off", False); log("swap re-enabled."); return 0


def usb_lock():
    st = load_state(); prev = st.setdefault("usb_prev", {})
    for f in glob.glob("/sys/bus/usb/devices/usb*/authorized_default"):
        try:
            prev[f] = open(f).read().strip()
            with open(f, "w") as h: h.write("0")
        except OSError: pass
    save_state(st); flag("usb_lock", True)
    log("USB lockdown — new devices blocked (existing keep working)."); return 0


def usb_unlock():
    st = load_state()
    for f, v in st.get("usb_prev", {}).items():
        try:
            with open(f, "w") as h: h.write(v or "1")
        except OSError: pass
    st.pop("usb_prev", None); st.pop("usb_lock", None); save_state(st)
    log("USB lockdown lifted."); return 0


WEBCAM_CONF = "/etc/modprobe.d/hawkopsec-webcam.conf"


def webcam_off():
    """Unload the UVC webcam driver and block it from loading again."""
    write_file(WEBCAM_CONF, "# HawkOpsec: webcam disabled\n"
               "blacklist uvcvideo\ninstall uvcvideo /bin/false\n")
    rc, o = run(["modprobe", "-r", "uvcvideo"])
    if rc != 0 and "not found" not in o and glob.glob("/dev/video*"):
        log("webcam driver is busy — close apps using the camera, then retry. " + o.strip())
        flag("webcam_off", True); return 1
    flag("webcam_off", True); log("webcam disabled (uvcvideo unloaded + blocked)."); return 0


def webcam_on():
    if os.path.exists(WEBCAM_CONF): os.remove(WEBCAM_CONF)
    run(["modprobe", "uvcvideo"])
    st = load_state(); st.pop("webcam_off", None); save_state(st)
    log("webcam re-enabled."); return 0


NM_MAC_CONF = "/etc/NetworkManager/conf.d/hawkopsec-mac.conf"


def nm_mac_on():
    if not os.path.isdir("/etc/NetworkManager"):
        log("NetworkManager not present; skipping."); return 1
    write_file(NM_MAC_CONF,
               "[device]\nwifi.scan-rand-mac-address=yes\n\n"
               "[connection]\nwifi.cloned-mac-address=random\n"
               "ethernet.cloned-mac-address=random\n")
    run(["systemctl", "restart", "NetworkManager"])
    flag("nm_mac", True)
    log("NetworkManager persistent MAC randomization ON."); return 0


def nm_mac_off():
    if os.path.exists(NM_MAC_CONF): os.remove(NM_MAC_CONF)
    run(["systemctl", "restart", "NetworkManager"])
    flag("nm_mac", False); log("NetworkManager MAC randomization OFF."); return 0


RAMWIPE_SVC = "/etc/systemd/system/hawkopsec-ramwipe.service"


def ramwipe_on():
    write_file(RAMWIPE_SVC,
               "[Unit]\nDescription=HawkOpsec RAM wipe on shutdown\n"
               "DefaultDependencies=no\nBefore=shutdown.target umount.target\n\n"
               "[Service]\nType=oneshot\nRemainAfterExit=yes\n"
               "ExecStart=/bin/sh -c 'sync; echo 3 > /proc/sys/vm/drop_caches; "
               "swapoff -a 2>/dev/null; command -v sdmem >/dev/null && sdmem -llv 2>/dev/null || true'\n\n"
               "[Install]\nWantedBy=shutdown.target\n")
    run(["systemctl", "daemon-reload"])
    run(["systemctl", "enable", "hawkopsec-ramwipe.service"])
    flag("ramwipe", True)
    log("RAM wipe on shutdown ENABLED (cold-boot mitigation)."); return 0


def ramwipe_off():
    run(["systemctl", "disable", "hawkopsec-ramwipe.service"])
    if os.path.exists(RAMWIPE_SVC): os.remove(RAMWIPE_SVC)
    run(["systemctl", "daemon-reload"])
    flag("ramwipe", False); log("RAM wipe on shutdown DISABLED."); return 0


