def set_mode(name):
    flag("mode", name); log(f"mode -> {name}"); return 0


def reset_all():
    log("=== RESET: restoring pre-HawkOpsec state ===")
    st = load_state()
    steps = [
        (panic_clear,         st.get("panic")),
        (tor_off,             st.get("tor")),
        (dns_restore,         st.get("dns")),
        (firewall_off,        st.get("firewall")),
        (ipv6_on,             st.get("ipv6_off")),
        (unharden_sysctl,     st.get("sysctl")),
        (telemetry_restore,   st.get("telemetry")),
        (journald_persistent, st.get("journald_volatile")),
        (usb_unlock,          st.get("usb_lock")),
        (ramwipe_off,         st.get("ramwipe")),
        (nm_mac_off,          st.get("nm_mac")),
        (swap_on,             st.get("swap_off")),
        (bluetooth_on,        st.get("bluetooth_off")),
        (webcam_on,           st.get("webcam_off")),
        (machineid_restore,   st.get("machineid")),
        (hostname_restore,    st.get("hostname_orig")),
        (tz_restore,          st.get("tz_orig")),
        (mac_restore_all,     st.get("mac_orig")),
    ]
    for fn, cond in steps:
        try:
            if cond: fn()
        except Exception as e: log(f"reset step error: {e}")
    # Bring DNS / network back cleanly — but only if we actually touched them.
    # Restarting NetworkManager unconditionally dropped the link for a few
    # seconds after every BASELINE switch and broke the follow-up IP check.
    if st.get("tor") or st.get("dns"):
        run(["systemctl", "restart", "systemd-resolved"])
    if st.get("nm_mac") or st.get("mac_orig") or st.get("panic"):
        run(["systemctl", "restart", "NetworkManager"])
    try:
        shutil.rmtree(BACKUP_DIR, ignore_errors=True)
        if os.path.exists(STATE_FILE): os.remove(STATE_FILE)
    except OSError: pass
    ensure_dirs(); save_state({"mode": "BASELINE"})
    log("=== RESET complete — system back to baseline ===")
    return 0


VERBS = {
    "tor-on": tor_on, "tor-off": tor_off,
    "dns-set": dns_set, "dns-restore": dns_restore,
    "mac-random": mac_random, "mac-restore": mac_restore, "mac-restore-all": mac_restore_all,
    "hostname-random": hostname_random, "hostname-restore": hostname_restore,
    "tz-utc": tz_utc, "tz-restore": tz_restore,
    "machineid-random": machineid_random, "machineid-restore": machineid_restore,
    "harden-sysctl": harden_sysctl, "unharden-sysctl": unharden_sysctl,
    "firewall-on": firewall_on, "firewall-off": firewall_off,
    "telemetry-off": telemetry_off, "telemetry-restore": telemetry_restore,
    "ipv6-off": ipv6_off, "ipv6-on": ipv6_on,
    "bluetooth-off": bluetooth_off, "bluetooth-on": bluetooth_on,
    "webcam-off": webcam_off, "webcam-on": webcam_on,
