def clean_system():
    run(["journalctl", "--rotate"]); run(["journalctl", "--vacuum-time=1s"])
    run(["resolvectl", "flush-caches"])          # visited domains in the DNS cache
    if have("nscd"): run(["nscd", "-i", "hosts"])
    if have("paccache"): run(["paccache", "-rk0"])
    elif have("pacman"): run(["pacman", "-Scc", "--noconfirm"])
    elif have("apt-get"): run(["apt-get", "clean"])
    cd = "/var/lib/systemd/coredump"
    if os.path.isdir(cd):
        for f in os.listdir(cd):
            try: os.remove(os.path.join(cd, f))
            except OSError: pass
    for w in ("/var/log/wtmp", "/var/log/btmp", "/var/log/lastlog"):
        try: open(w, "w").close()
        except OSError: pass
    log("journals, DNS cache, coredumps, logins and package cache cleaned."); return 0


JRN_DROPIN = "/etc/systemd/journald.conf.d/hawkopsec.conf"


def journald_volatile():
    write_file(JRN_DROPIN, "[Journal]\nStorage=volatile\n")
    run(["systemctl", "restart", "systemd-journald"])
    flag("journald_volatile", True); log("journald -> volatile (RAM only)."); return 0


def journald_persistent():
    if os.path.exists(JRN_DROPIN): os.remove(JRN_DROPIN)
    run(["systemctl", "restart", "systemd-journald"])
    flag("journald_volatile", False); log("journald storage restored."); return 0


# --------------------------------------------------------------------------- #
#  Panic
# --------------------------------------------------------------------------- #
def panic():
    run(["nft", "-f", "-"], input_text="""
table inet hawkopsec_panic {
  chain input {
    type filter hook input priority -300; policy drop;
    iif lo accept
  }
  chain output {
    type filter hook output priority -300; policy drop;
    oif lo accept
  }
  chain forward {
    type filter hook forward priority -300; policy drop;
  }
}
""")
    for i in net_ifaces(): run(["ip", "link", "set", "dev", i, "down"])
    for n in PANIC_KILL: run(["pkill", "-9", "-x", n])
    run(["sync"])
    try:
        with open("/proc/sys/vm/drop_caches", "w") as f: f.write("3\n")
    except OSError: pass
    flag("panic", True); log("PANIC engaged."); return 0


def panic_clear():
    run(["nft", "delete", "table", "inet", "hawkopsec_panic"])
    for i in net_ifaces(): run(["ip", "link", "set", "dev", i, "up"])
    flag("panic", False); log("panic cleared, interfaces up."); return 0


