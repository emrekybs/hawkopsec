def main():
    if os.geteuid() != 0:
        log("ERROR: helper must run as root (via pkexec)."); return 2
    ensure_dirs()
    if len(sys.argv) < 2 or sys.argv[1] not in VERBS:
        log("usage: hawkopsec-helper <" + "|".join(VERBS) + ">"); return 2
    verb, args = sys.argv[1], sys.argv[2:]
    try:
        return VERBS[verb](*args) or 0
    except TypeError as e:
        log(f"bad arguments for {verb}: {e}"); return 2


if __name__ == "__main__":
    sys.exit(main())
